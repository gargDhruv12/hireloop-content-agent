{
  "name": "hireloop-content-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Research a topic, write a reviewed content pack and a matching image for HireLoop. A person approves everything; nothing is published automatically.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:postgres": "tsx scripts/smoke.ts --postgres",
    "eval": "tsx evals/run-evals.ts",
    "eval:checker": "tsx evals/run-evals.ts --checker",
    "demo": "node scripts/demo.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.140",
    "@vercel/blob": "2.8.2",
    "ai": "^6.0.318",
    "next": "^16.0.0",
    "postgres": "3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@neon/config": "^1.10.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "zod": "$zod"
  }
}
