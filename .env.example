# ── Gemini ───────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Text model for research, planning, checking and the image brief.
TEXT_MODEL=gemini-3.8-flash
# Writer model. Try gemini-4-argon here if Flash's writing feels flat.
WRITER_MODEL=gemini-3.8-flash
# Image model (Nano Banana 2.1).
IMAGE_MODEL=gemini-nano-banana-2.1
# Optional, comma-separated. Tried in order when the text or writer model is overloaded or rate-limited.
FALLBACK_TEXT_MODEL=gemini-3.5-flash,gemini-3.7-flash

# ── Client ───────────────────────────────────────────────────────────
# The researcher reads HireLoop's live site every run. Leave empty for the
# default (the HireLoop demo site), set another URL, or set "off" to use only
# the facts in src/clients/hireloop.ts.
CLIENT_SITE_URL=

# ── Access and spend ─────────────────────────────────────────────────
# Set a password before deploying anywhere public. Every page and API route
# then asks for it (any user name). Empty = open, fine on your own laptop.
APP_PASSWORD=
# Packs one address can start per hour (0 = no cap). Also set a spend cap in AI Studio.
RUNS_PER_HOUR=20

# ── Offline demo ─────────────────────────────────────────────────────
# 1 = no API calls. Uses saved sample output so you can work on the UI
# (or rescue a demo) without a key or credits.
MOCK_AI=0
