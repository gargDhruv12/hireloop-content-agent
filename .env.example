# ── Gemini ───────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Text model for research, planning, checking and the image brief.
TEXT_MODEL=gemini-3.8-flash
# Writer model. Try gemini-4-argon here if Flash's writing feels flat.
WRITER_MODEL=gemini-3.8-flash
# Image model (Nano Banana 2.1).
IMAGE_MODEL=gemini-nano-banana-2.1

# ── Client ───────────────────────────────────────────────────────────
# Optional. If HireLoop's site is online, the researcher reads it live.
# Leave empty to use only the facts in src/clients/hireloop.ts.
CLIENT_SITE_URL=

# ── Offline demo ─────────────────────────────────────────────────────
# 1 = no API calls. Uses saved sample output so you can work on the UI
# (or rescue a demo) without a key or credits.
MOCK_AI=0
